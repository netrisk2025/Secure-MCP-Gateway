# AppArmor profile for smcpd, the Secure MCP Gateway daemon (enforced
# profile, FR-13.5). Installed as /etc/apparmor.d/smcpd and loaded by
# packaging/linux/install-enforced.sh when AppArmor is enabled;
# smcpd.service applies it with AppArmorProfile=-smcpd.
#
# smcpd may read its configuration, write only its own state, runtime and
# log directories, and execute nothing but Podman. Podman runs under its
# own AppArmor profile when the host has one, and unconfined otherwise
# (PUx): rootless Podman needs user namespaces, mounts and setuid ID-map
# helpers that a daemon profile should not grant. The containers Podman
# starts are confined by the Execution Sandbox profile (docs/sandbox.md).
#
# Host directories granted to servers as mounts must be readable here as
# well. /srv is allowed; add other mount sources to
# /etc/apparmor.d/local/smcpd, for example:
#   /data/projects/** r,
# then reload: apparmor_parser -r /etc/apparmor.d/smcpd

abi <abi/3.0>,

include <tunables/global>

profile smcpd /usr/local/bin/smcpd flags=(attach_disconnected) {
  include <abstractions/base>
  include <abstractions/nameservice>
  include <abstractions/ssl_certs>

  network inet stream,
  network inet6 stream,
  network inet dgram,
  network inet6 dgram,
  network unix,
  network netlink raw,

  /usr/local/bin/smcpd mr,
  /usr/local/bin/smcp-refserver r,

  # Configuration (root:smcp 0640) and state (CP-46 directories).
  /etc/smcp/ r,
  /etc/smcp/** r,
  /var/lib/smcp/ r,
  /var/lib/smcp/** rwkl,
  /run/smcp/ rw,
  /run/smcp/** rwkl,
  /var/log/smcp/ r,
  /var/log/smcp/** rw,
  /tmp/ r,
  owner /tmp/** rwkl,

  # Prerequisite checks (smcpctl runtime doctor) and the Runtime Monitor:
  # kernel settings, subordinate ID ranges, cgroup files and the names of
  # processes in instance cgroups.
  /etc/subuid r,
  /etc/subgid r,
  @{PROC}/sys/** r,
  @{PROC}/@{pid}/** r,
  @{PROC}/[0-9]*/comm r,
  @{PROC}/[0-9]*/stat r,
  /sys/fs/cgroup/ r,
  /sys/fs/cgroup/** r,
  # Enabling cpu, memory and pids for the containers in the delegated
  # service cgroup (owned by smcp-core).
  owner /sys/fs/cgroup/**/cgroup.subtree_control w,
  /sys/kernel/security/ r,
  /sys/kernel/security/apparmor/ r,
  /sys/fs/selinux/ r,
  /sys/kernel/mm/transparent_hugepage/** r,
  /sys/devices/system/cpu/** r,

  # Server mount sources (read; write grants also need ReadWritePaths= in
  # a drop-in of smcpd.service).
  /srv/ r,
  /srv/** r,

  # Podman and the tools of the prerequisite checks. PUx: Podman's own
  # profile if the host has one, else unconfined.
  /usr/bin/podman PUx,
  /usr/local/bin/podman PUx,
  # Podman as the server identity (runtime.run_as): sudo, whose sudoers
  # rule allows only Podman as smcp-srv.
  /usr/bin/sudo PUx,
  # The apparmor-server doctor check.
  /sys/kernel/security/apparmor/profiles r,
  /sys/kernel/security/apparmor/policy/profiles/ r,
  /sys/kernel/security/apparmor/policy/profiles/*/{name,mode} r,
  # apparmorfs paths are reported relative to the securityfs mount.
  /profiles/ r,
  /profiles/*/{name,mode} r,
  /usr/bin/newuidmap r,
  /usr/bin/newgidmap r,
  /usr/sbin/nft r,
  /usr/bin/crun r,

  # Shutdown of server instances: smcpd signals the Podman client it
  # started.
  signal (send) set=(term, kill, int, hup),

  include if exists <local/smcpd>
}
