{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ethan03805/Secure-MCP-Gateway/blob/main/docs/schemas/manifest.schema.json",
  "title": "Secure MCP Gateway server package manifest, version 1",
  "description": "Contract between the packaging step (smcpctl package build, or an external curation system) and the Library Trust Verifier (E-13). Normative for SRS FR-14.11 and Appendix J. The signature is not part of the manifest; it covers the package index that lists the manifest digest.",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifest_version", "server", "artifact", "launch", "era", "risk_class", "instance_scope", "tools", "capabilities", "provenance", "packaging"],
  "properties": {
    "manifest_version": { "const": 1 },
    "server": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "revision", "alias", "publisher"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}$", "description": "Stable server ID across revisions." },
        "revision": { "type": "string", "pattern": "^[0-9A-Za-z][0-9A-Za-z.+_-]{0,63}$", "description": "Upstream version; compared for rollback protection (SR-3-5)." },
        "alias": { "type": "string", "pattern": "^[a-z0-9]{1,16}$", "description": "Default public-name prefix (CP-42)." },
        "publisher": { "type": "string", "minLength": 1, "maxLength": 200 },
        "description": { "type": "string", "maxLength": 2000 },
        "homepage": { "type": "string", "format": "uri", "pattern": "^https://" }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "reference", "version", "sha256"],
      "properties": {
        "type": { "enum": ["npm", "pypi", "oci", "binary"] },
        "reference": { "type": "string", "minLength": 1, "maxLength": 512, "description": "Package name, image repository or download URL used at packaging time only (X-17)." },
        "version": { "type": "string", "minLength": 1, "maxLength": 128, "not": { "enum": ["latest", "*", "next", "stable"] }, "description": "Exact version; ranges and dist-tags are refused (FR-14.2)." },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$", "description": "SHA-256 of the stored artifact; the cache key in D-03." },
        "registry_integrity": { "type": "string", "maxLength": 200, "description": "Registry-native integrity value, e.g. npm sha512 integrity or OCI manifest digest." },
        "size_bytes": { "type": "integer", "minimum": 1 }
      }
    },
    "launch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtime", "argv"],
      "properties": {
        "runtime": { "enum": ["node", "python", "oci", "native"], "description": "How E-15 runs the artifact: node or python from the release-pinned runtime against the unpacked artifact, an OCI image, or a native executable." },
        "argv": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": { "type": "string", "maxLength": 4096 },
          "prefixItems": [
            { "type": "string", "not": { "pattern": "^(.*/)?(npx|uvx|uv|pip|pip3|pipx|npm|pnpm|yarn|bunx|bun|sh|bash|zsh|dash|curl|wget)$" } }
          ],
          "description": "Exact argument vector, executed without a shell (SR-4.8-1). Paths are relative to the unpacked artifact. Package installers and shells are refused (SR-3.6-1)."
        },
        "env_allowlist": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[A-Z_][A-Z0-9_]{0,63}$" },
          "uniqueItems": true,
          "description": "Environment variable names the instance may receive (SR-2.14-1)."
        },
        "env_fixed": {
          "type": "object",
          "propertyNames": { "pattern": "^[A-Z_][A-Z0-9_]{0,63}$" },
          "additionalProperties": { "type": "string", "maxLength": 1024 },
          "description": "Non-secret values set at launch. Secrets are never placed here; they use secret slots."
        }
      }
    },
    "era": { "enum": ["2026-07-28", "2025-11-25"], "description": "Southbound protocol era observed at packaging (FR-5.16, FR-5.17)." },
    "risk_class": { "enum": ["low", "moderate", "high"], "description": "Operator classification (CP-44). Refused at enablement in the Standalone profile when high (SR-4-1)." },
    "instance_scope": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["per-call", "per-session", "per-principal", "shared"] },
      "description": "Scopes the server supports; policy selects one (FR-5.10)."
    },
    "stateful": { "type": "boolean", "default": false },
    "tools": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "description_sha256", "input_schema", "side_effect", "source_trust"],
        "properties": {
          "name": { "type": "string", "pattern": "^[A-Za-z0-9_]{1,47}$", "description": "Backend tool name; the public name is <alias>_<name>, at most 64 characters (CP-42)." },
          "title": { "type": "string", "maxLength": 200 },
          "description": { "type": "string", "maxLength": 8192 },
          "description_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "input_schema": { "type": "object", "description": "JSON Schema 2020-12 or draft-07 object schema as returned by tools/list. Remote $ref is refused at import (SR-1.8-3)." },
          "output_schema": { "type": "object" },
          "annotations": { "type": "object" },
          "side_effect": { "enum": ["read", "write", "external", "execute"], "description": "CP-44 side-effect class; drives session taint (SR-5.13-2)." },
          "source_trust": { "enum": ["trusted", "untrusted"], "description": "Whether results carry content from outside the operator's control (CP-44)." },
          "risk_class": { "enum": ["low", "moderate", "high"], "description": "Per-tool override; may only raise the server risk class." },
          "class": { "enum": ["standard", "gateway-admin"], "description": "gateway-admin: the tool administers the Gateway; it is never presented in a catalog, whatever the policy grants (SR-3.12-1). Absent means standard." }
        }
      }
    },
    "tools_list_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$", "description": "Digest of the canonical tools/list result read at packaging; compared at run time for drift (SR-3.7-1, SR-3.8-1)." },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["filesystem", "egress", "spawns_processes", "resources"],
      "properties": {
        "filesystem": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["slot", "mode"],
            "properties": {
              "slot": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,31}$", "description": "Named mount point; policy binds a host path to it within this ceiling." },
              "mode": { "enum": ["ro", "rw"] },
              "argv_placeholder": { "type": "string", "pattern": "^\\{[a-z][a-z0-9_]{0,31}\\}$", "description": "Placeholder in launch.argv replaced by the in-sandbox mount path." }
            }
          }
        },
        "egress": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["host", "ports", "methods"],
            "properties": {
              "host": { "type": "string", "pattern": "^(\\*\\.)?[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?)+$" },
              "ports": { "type": "array", "minItems": 1, "items": { "type": "integer", "minimum": 1, "maximum": 65535 } },
              "methods": { "type": "array", "minItems": 1, "items": { "enum": ["GET", "HEAD", "POST", "PUT", "PATCH", "DELETE", "CONNECT-TLS"] } },
              "request_bytes": { "type": "integer", "minimum": 1, "description": "Upper bound on the request size of each outbound operation to this destination (FR-5.38)." },
              "response_bytes": { "type": "integer", "minimum": 1, "description": "Upper bound on the response size of each outbound operation to this destination (FR-5.38)." },
              "timeout_ms": { "type": "integer", "minimum": 1, "maximum": 3600000, "description": "Upper bound on the duration of each outbound operation to this destination (FR-5.38)." }
            }
          }
        },
        "spawns_processes": { "type": "boolean" },
        "resources": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "memory_mib": { "type": "integer", "minimum": 16, "maximum": 65536 },
            "cpus": { "type": "number", "exclusiveMinimum": 0, "maximum": 64 },
            "pids": { "type": "integer", "minimum": 1, "maximum": 32768 },
            "wall_seconds": { "type": "integer", "minimum": 1, "maximum": 3600 }
          }
        }
      }
    },
    "secrets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["slot", "purpose", "modes"],
        "properties": {
          "slot": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,31}$" },
          "purpose": { "type": "string", "maxLength": 500 },
          "destination": { "type": "string", "description": "Host the secret may be sent to; required for mode S1." },
          "modes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["S1", "S2", "S3", "S4"] } },
          "env_name": { "type": "string", "pattern": "^[A-Z_][A-Z0-9_]{0,63}$", "description": "Variable name for mode S4 only." }
        }
      }
    },
    "behavior_hints": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "rules": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind"],
            "properties": {
              "kind": { "enum": ["no_process_spawn", "no_file_write", "max_file_write_bytes", "no_egress", "max_egress_bytes", "fixed_tool_list"] },
              "value": { "type": "integer", "minimum": 0 }
            }
          }
        },
        "expected": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "response_bytes_p95": { "type": "integer", "minimum": 0 },
            "latency_ms_p95": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "licenses", "statement_sha256"],
      "properties": {
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "uri", "sha256"],
          "properties": {
            "kind": { "enum": ["registry-tarball", "sdist", "oci-source-label", "archive"] },
            "uri": { "type": "string", "minLength": 1, "maxLength": 1024 },
            "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
            "vcs_commit": { "type": "string", "pattern": "^[a-f0-9]{7,64}$" }
          }
        },
        "licenses": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[A-Za-z0-9.+-]+( (AND|OR|WITH) [A-Za-z0-9.+-]+)*$" }, "description": "SPDX license expressions (SR-3.1-1)." },
        "statement_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$", "description": "Digest of provenance.json, which binds the source digest to the artifact digest (SR-3.2-1)." }
      }
    },
    "packaging": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool", "tool_version", "built_at"],
      "properties": {
        "tool": { "type": "string", "maxLength": 100, "description": "smcpctl package, or the name of an external curation system." },
        "tool_version": { "type": "string", "maxLength": 64 },
        "built_at": { "type": "string", "format": "date-time" },
        "operator_note": { "type": "string", "maxLength": 2000 }
      }
    },
    "attestations": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "review_status": { "enum": ["reviewed", "classified-only"] },
        "advisories_checked_at": { "type": "string", "format": "date-time" },
        "recuration_due": { "type": "string", "format": "date" }
      }
    },
    "expires": { "type": "string", "format": "date", "description": "After this date E-14 suspends the revision (FR-5.8)." }
  }
}
