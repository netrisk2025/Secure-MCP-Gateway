{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "policy.schema.json",
  "title": "Secure MCP Gateway policy revision, schema version 1 (Framework Profiles and Session Allow Policy Templates)",
  "type": "object",
  "additionalProperties": false,
  "required": ["revision", "framework_profiles", "templates"],
  "properties": {
    "revision": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$" },
    "framework_profiles": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["templates", "default_template"],
        "properties": {
          "templates": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "default_template": { "type": "string" },
          "calls_per_minute": { "type": "integer", "minimum": 1 },
          "servers": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9]{1,16}$" } },
          "high_risk": { "type": "array", "uniqueItems": true, "items": { "type": "string", "enum": ["general-sql", "code-execution", "cad-scripting", "browser-automation"] } },
          "remote_allowed": { "type": "array", "uniqueItems": true, "items": { "type": "string" } }
        }
      }
    },
    "templates": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["rules"],
        "properties": {
          "description": { "type": "string" },
          "calls_per_minute": { "type": "integer", "minimum": 1 },
          "calls_per_session": { "type": "integer", "minimum": 1 },
          "taint_action": { "type": "string", "enum": ["approve", "deny"] },
          "high_risk": { "type": "array", "uniqueItems": true, "items": { "type": "string", "enum": ["general-sql", "code-execution", "cad-scripting", "browser-automation"] } },
          "rules": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "server", "tools"],
              "properties": {
                "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$" },
                "effect": { "type": "string", "enum": ["permit", "deny"] },
                "server": { "type": "string", "pattern": "^[a-z0-9]{1,16}$" },
                "tools": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
                "approval": { "type": "boolean" },
                "calls_per_minute": { "type": "integer", "minimum": 1 },
                "calls_per_session": { "type": "integer", "minimum": 1 },
                "side_effect": { "type": "string", "enum": ["read", "write", "external", "execute"] },
                "source_trust": { "type": "string", "enum": ["trusted", "untrusted"] },
                "filters": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" } },
                "egress_limits": {
                  "type": "object",
                  "additionalProperties": false,
                  "minProperties": 1,
                  "description": "Bounds on each egress operation of the calls this rule permits (FR-5.38); the smallest of these, the manifest's and the configuration's applies.",
                  "properties": {
                    "request_bytes": { "type": "integer", "minimum": 1 },
                    "response_bytes": { "type": "integer", "minimum": 1 },
                    "timeout_ms": { "type": "integer", "minimum": 1, "maximum": 3600000 }
                  }
                },
                "when": {
                  "type": "array",
                  "maxItems": 32,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["op"],
                    "properties": {
                      "op": { "type": "string", "enum": ["eq", "in", "range", "path_within", "url_in", "data_class_in", "expiry", "approval"] },
                      "arg": { "type": "string", "pattern": "^[A-Za-z0-9_.\\-]{1,128}$" },
                      "value": {},
                      "min": { "type": "number" },
                      "max": { "type": "number" },
                      "not_before": { "type": "string", "format": "date-time" },
                      "not_after": { "type": "string", "format": "date-time" }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
