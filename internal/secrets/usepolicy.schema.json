{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "usepolicy.schema.json",
  "title": "Secure MCP Gateway Secret Use Policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["revision"],
  "$defs": {
    "mode": { "type": "string", "enum": ["S1", "S2", "S3", "S4"] },
    "alias": { "type": "string", "pattern": "^[a-z0-9]{1,16}$" },
    "slot": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_.-]{0,63}$" },
    "env": { "type": "string", "pattern": "^[A-Z_][A-Z0-9_]{0,63}$" },
    "time": { "type": "string", "format": "date-time" },
    "clock": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" }
  },
  "properties": {
    "revision": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,64}$" },
    "slots": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["server", "name", "modes"],
        "properties": {
          "server": { "$ref": "#/$defs/alias" },
          "name": { "$ref": "#/$defs/slot" },
          "modes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/mode" } },
          "env": { "$ref": "#/$defs/env" },
          "file_env": { "$ref": "#/$defs/env" },
          "header": { "type": "string", "pattern": "^[A-Za-z0-9-]{1,64}$" },
          "header_template": { "type": "string", "minLength": 1, "maxLength": 256 },
          "destination": { "type": "string", "minLength": 1, "maxLength": 253 }
        }
      }
    },
    "policies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "secret", "server", "slot", "mode", "tools", "purpose"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,64}$" },
          "secret": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" },
          "version": { "type": "integer", "minimum": 0 },
          "server": { "$ref": "#/$defs/alias" },
          "slot": { "$ref": "#/$defs/slot" },
          "mode": { "$ref": "#/$defs/mode" },
          "tools": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "destination": { "type": "string", "minLength": 1, "maxLength": 253 },
          "purpose": { "type": "string", "minLength": 1, "maxLength": 256 },
          "session_purpose": { "type": "string", "minLength": 1, "maxLength": 256 },
          "calls_per_minute": { "type": "integer", "minimum": 0 },
          "not_before": { "$ref": "#/$defs/time" },
          "not_after": { "$ref": "#/$defs/time" },
          "hours": {
            "type": "object",
            "additionalProperties": false,
            "required": ["start", "end"],
            "properties": { "start": { "$ref": "#/$defs/clock" }, "end": { "$ref": "#/$defs/clock" } }
          },
          "approval": { "type": "boolean" },
          "s4_waiver": {
            "type": "object",
            "additionalProperties": false,
            "required": ["approved_by", "reason"],
            "properties": {
              "approved_by": { "type": "string", "minLength": 1 },
              "reason": { "type": "string", "minLength": 1 },
              "expires": { "$ref": "#/$defs/time" }
            }
          }
        }
      }
    }
  }
}
