// Migration 1: a uniqueness constraint on id for every Appendix D label (FR-9.1).
// Statements are separated by semicolons; each runs in its own transaction.
CREATE CONSTRAINT smcp_principal_id IF NOT EXISTS FOR (n:Principal) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT smcp_credential_ref_id IF NOT EXISTS FOR (n:CredentialRef) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT smcp_session_id IF NOT EXISTS FOR (n:Session) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT smcp_server_id IF NOT EXISTS FOR (n:Server) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT smcp_server_revision_id IF NOT EXISTS FOR (n:ServerRevision) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT smcp_tool_revision_id IF NOT EXISTS FOR (n:ToolRevision) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT smcp_import_receipt_id IF NOT EXISTS FOR (n:ImportReceipt) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT smcp_trust_anchor_id IF NOT EXISTS FOR (n:TrustAnchor) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT smcp_policy_control_id IF NOT EXISTS FOR (n:PolicyControl) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT smcp_policy_revision_id IF NOT EXISTS FOR (n:PolicyRevision) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT smcp_policy_object_id IF NOT EXISTS FOR (n:PolicyObject) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT smcp_rule_revision_id IF NOT EXISTS FOR (n:RuleRevision) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT smcp_route_revision_id IF NOT EXISTS FOR (n:RouteRevision) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT smcp_approval_id IF NOT EXISTS FOR (n:Approval) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT smcp_decision_id IF NOT EXISTS FOR (n:Decision) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT smcp_invocation_id IF NOT EXISTS FOR (n:Invocation) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT smcp_audit_event_id IF NOT EXISTS FOR (n:AuditEvent) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT smcp_payload_ref_id IF NOT EXISTS FOR (n:PayloadRef) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT smcp_outbox_record_id IF NOT EXISTS FOR (n:OutboxRecord) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT smcp_checkpoint_id IF NOT EXISTS FOR (n:Checkpoint) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT smcp_secret_ref_id IF NOT EXISTS FOR (n:SecretRef) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT smcp_secret_use_id IF NOT EXISTS FOR (n:SecretUse) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT smcp_baseline_context_id IF NOT EXISTS FOR (n:BaselineContext) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT smcp_feature_stat_id IF NOT EXISTS FOR (n:FeatureStat) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT smcp_baseline_snapshot_id IF NOT EXISTS FOR (n:BaselineSnapshot) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT smcp_abnormal_event_id IF NOT EXISTS FOR (n:AbnormalEvent) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT smcp_parameter_id IF NOT EXISTS FOR (n:Parameter) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT smcp_catalog_version_id IF NOT EXISTS FOR (n:CatalogVersion) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT smcp_campaign_id IF NOT EXISTS FOR (n:Campaign) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT smcp_dataset_id IF NOT EXISTS FOR (n:Dataset) REQUIRE n.id IS UNIQUE;
