{
  "id": "secret-formats",
  "version": "2026.10.1",
  "description": "Known credential formats (block in arguments, redact in results) and a high-entropy token heuristic (tag only). Matched content is never recorded.",
  "rules": [
    {
      "id": "aws-access-key-id",
      "kind": "regex",
      "description": "AWS access key ID.",
      "pattern": "\\b(?:AKIA|ASIA|ABIA|ACCA)[0-9A-Z]{16}\\b",
      "request_action": "block",
      "response_action": "redact",
      "case_sensitive": true
    },
    {
      "id": "aws-secret-access-key",
      "kind": "regex",
      "description": "AWS secret access key assignment.",
      "pattern": "aws_secret_access_key\\s*[=:]\\s*[\\\"']?[A-Za-z0-9/+=]{40}",
      "request_action": "block",
      "response_action": "redact"
    },
    {
      "id": "github-token",
      "kind": "regex",
      "description": "GitHub personal, OAuth, user-to-server, server-to-server or refresh token.",
      "pattern": "\\bgh[pousr]_[A-Za-z0-9]{36,255}\\b",
      "request_action": "block",
      "response_action": "redact",
      "case_sensitive": true
    },
    {
      "id": "github-fine-grained-token",
      "kind": "regex",
      "description": "GitHub fine-grained personal access token.",
      "pattern": "\\bgithub_pat_[A-Za-z0-9_]{60,255}\\b",
      "request_action": "block",
      "response_action": "redact",
      "case_sensitive": true
    },
    {
      "id": "gitlab-token",
      "kind": "regex",
      "description": "GitLab personal access token.",
      "pattern": "\\bglpat-[A-Za-z0-9_-]{20,}",
      "request_action": "block",
      "response_action": "redact",
      "case_sensitive": true
    },
    {
      "id": "slack-token",
      "kind": "regex",
      "description": "Slack bot, user, app or refresh token.",
      "pattern": "\\bxox[abposr]-[A-Za-z0-9-]{10,250}",
      "request_action": "block",
      "response_action": "redact",
      "case_sensitive": true
    },
    {
      "id": "slack-webhook",
      "kind": "regex",
      "description": "Slack incoming webhook URL.",
      "pattern": "https://hooks\\.slack\\.com/services/T[A-Z0-9]+/B[A-Z0-9]+/[A-Za-z0-9]+",
      "request_action": "block",
      "response_action": "redact",
      "case_sensitive": true
    },
    {
      "id": "stripe-live-key",
      "kind": "regex",
      "description": "Stripe live secret or restricted key.",
      "pattern": "\\b(?:sk|rk)_live_[A-Za-z0-9]{24,99}\\b",
      "request_action": "block",
      "response_action": "redact",
      "case_sensitive": true
    },
    {
      "id": "google-api-key",
      "kind": "regex",
      "description": "Google API key.",
      "pattern": "\\bAIza[0-9A-Za-z_-]{35}",
      "request_action": "block",
      "response_action": "redact",
      "case_sensitive": true
    },
    {
      "id": "anthropic-api-key",
      "kind": "regex",
      "description": "Anthropic API key.",
      "pattern": "\\bsk-ant-[A-Za-z0-9_-]{32,}",
      "request_action": "block",
      "response_action": "redact",
      "case_sensitive": true
    },
    {
      "id": "openai-api-key",
      "kind": "regex",
      "description": "OpenAI API key (contains the T3BlbkFJ marker).",
      "pattern": "\\bsk-(?:proj-|svcacct-|admin-)?[A-Za-z0-9_-]{16,}T3BlbkFJ[A-Za-z0-9_-]{16,}",
      "request_action": "block",
      "response_action": "redact",
      "case_sensitive": true
    },
    {
      "id": "npm-token",
      "kind": "regex",
      "description": "npm access token.",
      "pattern": "\\bnpm_[A-Za-z0-9]{36}\\b",
      "request_action": "block",
      "response_action": "redact",
      "case_sensitive": true
    },
    {
      "id": "private-key-pem",
      "kind": "regex",
      "description": "PEM or OpenSSH private key header.",
      "pattern": "-----BEGIN (?:RSA |EC |DSA |OPENSSH |ENCRYPTED |PGP )?PRIVATE KEY(?: BLOCK)?-----",
      "request_action": "block",
      "response_action": "redact",
      "case_sensitive": true
    },
    {
      "id": "jwt",
      "kind": "regex",
      "description": "JSON Web Token (signed bearer token).",
      "pattern": "\\beyJ[A-Za-z0-9_-]{8,}\\.eyJ[A-Za-z0-9_-]{8,}\\.[A-Za-z0-9_-]{8,}",
      "request_action": "block",
      "response_action": "redact",
      "case_sensitive": true
    },
    {
      "id": "azure-storage-key",
      "kind": "regex",
      "description": "Azure storage account key in a connection string.",
      "pattern": "AccountKey=[A-Za-z0-9+/]{86}==",
      "request_action": "block",
      "response_action": "redact",
      "case_sensitive": true
    },
    {
      "id": "credential-assignment",
      "kind": "regex",
      "description": "A credential-looking assignment (tag only: also common in documentation).",
      "pattern": "\\b(?:password|passwd|pwd|secret|api[_-]?key|access[_-]?token|auth[_-]?token|client[_-]?secret)[\\\"']?\\s*[:=]\\s*[\\\"']?[^\\s\\\"',;<>]{8,}",
      "request_action": "tag",
      "response_action": "tag",
      "score": 0.5
    },
    {
      "id": "high-entropy-token",
      "kind": "entropy",
      "description": "A token of at least 24 characters with three character classes and at least 4.2 bits of entropy per character (tag only).",
      "pattern": "[A-Za-z0-9+/_=-]{24,}",
      "request_action": "tag",
      "response_action": "tag",
      "score": 0.4,
      "min_length": 24,
      "min_classes": 3,
      "min_entropy": 4.2
    }
  ]
}
